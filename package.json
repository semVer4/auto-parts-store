{
  "name": "avtodetal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "АвтоДеталь — интернет-магазин автозапчастей (React + Vite + TypeScript)",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/vite/bin/vite.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "3.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
